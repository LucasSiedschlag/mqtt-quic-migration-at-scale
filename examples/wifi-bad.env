# One test. Copy this file or edit it, then run:
#   docker compose --env-file examples/wifi-bad.env up --build --exit-code-from publisher
# Put each comment on its own line. Compose reads a comment after an empty value as the value.

# Folder for the results of this run. A new run in the same folder overwrites the files.
RESULTS=results/quic-200-wifi-bad

# tls or quic
TRANSPORT=quic
# Number of publishers, at most 8000. The neighbour table of the host has about 8192 entries.
PUBLISHERS=200
# Connection attempts per second, for all publishers together.
CONNECT_RATE=400
# Messages per second, for each publisher.
MESSAGE_RATE=1
# Payload size in bytes.
PAYLOAD_SIZE=256
# Seconds of messages that must arrive, then extra seconds of messages that can be lost when the publishers stop.
STEADY_SECONDS=30
PADDING_SECONDS=3
# Publisher i publishes on <TOPIC_PREFIX>/i. The subscriber listens on <TOPIC_PREFIX>/#.
TOPIC_PREFIX=bench

# Network profile: wifi-bad, at the two ends of the publisher link, in each direction.
# delay 3 ms and jitter 60 ms with distribution pareto: fitted to [10] Wi-Fi with interference (sigma 43 ms, p99 217 ms).
# Measured on netem: sigma 40 ms and p99 235 ms. But the median is 0.1 ms (source: 4.43 ms), because negative delays become 0.
# The max is 246 ms (source: 1187 ms).
# loss 8% with 25% correlation: no source. [10] contradicts it: 0.06% packet errors on Wi-Fi with interference.
# 8% is an extreme value for teaching. [9] only tells that weak Wi-Fi adds delay and jitter.
# [10] Mogensen et al., Aalborg 2019, Table II, https://vbn.aau.dk/ws/files/311896874/AAU_wirelessMES_implementation_and_evaluation_VTCFall2019.pdf
# [9] Bonaventure and Michel, IETF MNQEUWS interim 2021, Wi-Fi packet delivery time (not checked)
# limit 100000: the default netem queue (1000 packets) overflows when delay x packet rate is larger.
QDISC=netem limit 100000 delay 3ms 60ms distribution pareto loss 8% 25%

# Publisher network. Docker gives the containers addresses from CONTAINER_ADDRESSES.
PUBLISHER_SUBNET=10.77.0.0/16
CONTAINER_ADDRESSES=10.77.1.0/24
# Publisher i binds FIRST_PUBLISHER_ADDRESS + i. All these addresses must be in PUBLISHER_ADDRESSES.
# PUBLISHER_ADDRESSES must be in PUBLISHER_SUBNET and outside CONTAINER_ADDRESSES.
PUBLISHER_ADDRESSES=10.77.128.0/17
FIRST_PUBLISHER_ADDRESS=10.77.128.0

# Packet capture: set COMPOSE_PROFILES=capture and TLS_KEY_LOG=/results/keys.log.
COMPOSE_PROFILES=
TLS_KEY_LOG=
# Number of packets to keep, from the first packet.
CAPTURE_PACKETS=100000
