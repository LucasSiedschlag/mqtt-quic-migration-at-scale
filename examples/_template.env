# Template with every setting of a test. Copy it, change the values, then run:
#   docker compose --env-file examples/<your file>.env up --build --exit-code-from publisher
# A line that starts with # is off. To turn an option on, remove its #.

# Folder for the results
RESULTS_FOLDER=results/my-test

# Test
# tls or quic
TRANSPORT=quic
# Number of publishers (at most 8000)
PUBLISHERS=200
# Messages per second, for each publisher
MESSAGE_RATE=1
# Message size in bytes
PAYLOAD_BYTES=256
# Publisher i publishes on <TOPIC_PREFIX>/i
TOPIC_PREFIX=bench
# Connection attempts per second, for all publishers together
CONNECT_RATE=400
# Seconds of messages that must arrive
STEADY_SECONDS=30
# Extra seconds of messages, which can be lost when the publishers stop
PADDING_SECONDS=3

# Network profile: keep one QDISC line, put a # in front of the others
# lan: no impairment
QDISC=noqueue
# 4g, per direction: delay 30 ms, jitter 18 ms, loss 0.5% (Chrome DevTools Fast 4G; Mogensen et al. 2019)
# Reference: Chrome DevTools throttling presets, Fast 4G: 60 ms RTT. https://github.com/ChromeDevTools/devtools-frontend/blob/main/front_end/core/sdk/NetworkManager.ts
# Reference: Opensignal, Brazil mobile network experience 2019: 4G latency 58.7 to 68 ms. https://insights.opensignal.com/reports/2019/07/brazil/mobile-network-experience
# Reference: Mogensen et al., Aalborg 2019, Table II: public LTE, one way: sigma 17.9 ms, packet errors 0.5%. https://vbn.aau.dk/ws/files/311896874/AAU_wirelessMES_implementation_and_evaluation_VTCFall2019.pdf
#QDISC=netem limit 100000 delay 30ms 18ms 25% distribution normal loss 0.5%
# 3g, per direction: delay 200 ms, loss 1% (Chrome DevTools Slow 3G; the loss has no source)
# Reference: Chrome DevTools throttling presets, Slow 3G: 400 ms RTT. https://github.com/ChromeDevTools/devtools-frontend/blob/main/front_end/core/sdk/NetworkManager.ts
# Reference: Ferlin et al. 2013: UMTS uplink loss 0.025% and 0.066%, which contradicts the 1% loss
#QDISC=netem limit 100000 delay 200ms loss 1%
# satellite-geo, per direction: delay 337 ms, jitter 30 ms, loss 1% (Raman et al. 2023; jitter and loss have no source)
# Reference: Raman et al.: GEO median latency 673.5 ms; GEO jitter 100 ms or more in more than 80% of traces. https://arxiv.org/abs/2310.15808
# Reference: IIUM study: GEO physical minimum about 480 ms, 600 to 3000 ms measured at one terminal. https://irep.iium.edu.my/122700/
#QDISC=netem limit 100000 delay 337ms 30ms loss 1%
# wifi-bad, per direction: delay 3 ms, pareto jitter 60 ms, loss 8% (Mogensen et al. 2019; the loss has no source)
# Reference: Mogensen et al., Aalborg 2019, Table II: Wi-Fi with interference, one way: median 4.43 ms, p99 217 ms, max 1187 ms, sigma 43 ms, packet errors 0.06%. https://vbn.aau.dk/ws/files/311896874/AAU_wirelessMES_implementation_and_evaluation_VTCFall2019.pdf
# Reference: Bonaventure and Michel, IETF MNQEUWS interim 2021: weak Wi-Fi adds delay and jitter, qualitative only. https://datatracker.ietf.org/meeting/interim-2021-mnqeuws-02/materials/slides-interim-2021-mnqeuws-02-sessa-olivier-bonaventure-francois-michel-packet-delivery-time-as-a-tie-breaker-for-assessing-wi-fi-access-points-00.pdf
#QDISC=netem limit 100000 delay 3ms 60ms distribution pareto loss 8% 25%

# Broker configuration
# Outbound queue of each client, in messages: 1048576 for the tests of the methodology, 65536 for the address change test
BROKER_QUEUE_SIZE=1048576

# Networks
# Network of the publishers and the broker
PUBLISHER_NETWORK=10.77.0.0/16
# Addresses that Docker gives the containers
DOCKER_ADDRESS_RANGE=10.77.1.0/24
# Network of the subscriber and the broker
SUBSCRIBER_NETWORK=10.78.2.0/24

# Publisher addresses: keep one of the two groups, put a # in front of the lines of the other
# direct (tests of the methodology): on the publisher network; the broker finds each publisher with ARP
DIRECT_PUBLISHER_ADDRESSES=10.77.128.0/17
FIRST_PUBLISHER_ADDRESS=10.77.128.0
# routed (address change test): outside the networks; the broker routes all publishers to the publisher container
#ROUTED_PUBLISHER_ADDRESSES=10.88.0.0/16
#PUBLISHER_CONTAINER_ADDRESS=10.77.0.10
#FIRST_PUBLISHER_ADDRESS=10.88.0.0

# Address change test: needs the routed addresses. Remove the # of the four lines below to turn it on
# Seconds after publishing starts at which each publisher moves (at most three moves)
#MOVE_AT_SECONDS=8,16,24
# Mechanism at a move:
#   TLS reconnection           TRANSPORT=tls
#   QUIC reconnection, 1-RTT   TRANSPORT=quic  MOVE_MODE=reconnect  ZERO_RTT=false
#   QUIC reconnection, 0-RTT   TRANSPORT=quic  MOVE_MODE=reconnect  ZERO_RTT=true
#   QUIC migration             TRANSPORT=quic  MOVE_MODE=migrate
#MOVE_MODE=migrate
#ZERO_RTT=false
# Make the old addresses unusable at each move
#DROP_OLD_ADDRESSES=true

# Capture: remove the # of the three lines below to capture in the broker
# Packet capture in the broker
#COMPOSE_PROFILES=capture
# TLS keys for Wireshark
#TLS_KEY_LOG=/results/keys.log
# Number of packets to keep, from the first one
#CAPTURE_PACKETS=100000
