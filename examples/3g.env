# One test. Copy this file or edit it by hand, then run:
#   docker compose --env-file examples/3g.env up --build --exit-code-from publisher
# Comments go on their own lines: compose reads a comment after an empty value as the value.

# Folder for the results of this run; a new run into the same folder overwrites the files.
RESULTS=results/quic-200-3g

# tls or quic
TRANSPORT=quic
# Number of publishers, at most 8000 (the host's neighbour table holds about 8192 entries).
PUBLISHERS=200
# Connection attempts per second, all publishers together.
CONNECT_RATE=400
# Messages per second, per publisher.
MESSAGE_RATE=1
# Payload size in bytes.
PAYLOAD_SIZE=256
# Seconds of messages that must arrive, then extra seconds that may be lost when the publishers exit.
STEADY_SECONDS=30
PADDING_SECONDS=3
# Publisher i publishes on <TOPIC_PREFIX>/i; the subscriber listens on <TOPIC_PREFIX>/#.
TOPIC_PREFIX=bench

# Network profile: 3g, applied at both ends of the publisher link, per direction.
# delay 200 ms: [1] Slow 3G, 400 ms RTT.
# loss 1%: no source, and contradicted: UMTS uplink loss was measured at 0.025% and 0.066% (Ferlin et al. 2013).
# [1] Chrome DevTools throttling presets, https://github.com/ChromeDevTools/devtools-frontend/blob/main/front_end/core/sdk/NetworkManager.ts
# limit 100000: netem's default queue of 1000 packets overflows when delay x packet rate is larger.
QDISC=netem limit 100000 delay 200ms loss 1%

# Publisher network. Docker gives the containers addresses from CONTAINER_ADDRESSES.
PUBLISHER_SUBNET=10.77.0.0/16
CONTAINER_ADDRESSES=10.77.1.0/24
# Publisher i binds FIRST_PUBLISHER_ADDRESS + i. All of them must lie in PUBLISHER_ADDRESSES,
# which lies in PUBLISHER_SUBNET and outside CONTAINER_ADDRESSES.
PUBLISHER_ADDRESSES=10.77.128.0/17
FIRST_PUBLISHER_ADDRESS=10.77.128.0

# Packet capture: set COMPOSE_PROFILES=capture and TLS_KEY_LOG=/results/keys.log.
COMPOSE_PROFILES=
TLS_KEY_LOG=
# Packets kept, from the first one.
CAPTURE_PACKETS=100000
