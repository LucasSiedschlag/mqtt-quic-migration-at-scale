# One test. Copy this file or edit it, then run:
#   docker compose --env-file examples/3g.env up --build --exit-code-from publisher
# Put each comment on its own line. Compose reads a comment after an empty value as the value.

# Folder for the results of this run. A new run in the same folder overwrites the files.
RESULTS=results/quic-200-3g

# tls or quic
TRANSPORT=quic
# Number of publishers, at most 8000. The neighbour table of the host has about 8192 entries.
PUBLISHERS=200
# Connection attempts per second, for all publishers together.
CONNECT_RATE=400
# Messages per second, for each publisher.
MESSAGE_RATE=1
# Payload size in bytes.
PAYLOAD_SIZE=256
# Seconds of messages that must arrive, then extra seconds of messages that can be lost when the publishers stop.
STEADY_SECONDS=30
PADDING_SECONDS=3
# Publisher i publishes on <TOPIC_PREFIX>/i. The subscriber listens on <TOPIC_PREFIX>/#.
TOPIC_PREFIX=bench
# Address change test: seconds after publishing starts, separated by commas, at which each publisher
# moves to a new source address. Empty = no move. See examples/lan-move.env.
MOVE_AT=

# Capacity of the outbound queue of each client in the broker, in messages. The tests of the methodology
# use 1048576, so that the subscriber is not cut at scale. The address change test uses 65536 (see broker/main.go).
MAX_PENDING=1048576

# Network profile: 3g, at the two ends of the publisher link, in each direction.
# delay 200 ms: [1] Slow 3G, 400 ms RTT.
# loss 1%: no source. A measurement contradicts it: UMTS uplink loss of 0.025% and 0.066% (Ferlin et al. 2013).
# [1] Chrome DevTools throttling presets, https://github.com/ChromeDevTools/devtools-frontend/blob/main/front_end/core/sdk/NetworkManager.ts
# limit 100000: the default netem queue (1000 packets) overflows when delay x packet rate is larger.
QDISC=netem limit 100000 delay 200ms loss 1%

# Publisher network. Docker gives the containers addresses from CONTAINER_ADDRESSES.
PUBLISHER_SUBNET=10.77.0.0/16
CONTAINER_ADDRESSES=10.77.1.0/24
# Publisher i binds FIRST_PUBLISHER_ADDRESS + i. All these addresses must be in PUBLISHER_ADDRESSES.
# PUBLISHER_ADDRESSES must be in PUBLISHER_SUBNET and outside CONTAINER_ADDRESSES.
PUBLISHER_ADDRESSES=10.77.128.0/17
FIRST_PUBLISHER_ADDRESS=10.77.128.0
# Fixed address of the publisher container: in PUBLISHER_SUBNET and outside CONTAINER_ADDRESSES.
PUBLISHER_CONTAINER_ADDRESS=10.77.0.10
# Routed addresses for the address change test. The publisher container owns all of them.
ROUTED_ADDRESSES=10.88.0.0/16

# Packet capture: set COMPOSE_PROFILES=capture and TLS_KEY_LOG=/results/keys.log.
COMPOSE_PROFILES=
TLS_KEY_LOG=
# Number of packets to keep, from the first packet.
CAPTURE_PACKETS=100000
